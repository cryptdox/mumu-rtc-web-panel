# mumu-rtc-backend (control plane) base URL
VITE_API_URL=http://localhost:3001
# crypt-iam base URL
VITE_IAM_URL=http://localhost:5000
# IAM client-realm access code (x-cr-access-code) of the mumu client in the cryptdox realm.
# Everyone signs in with it; platform admins are users holding mumu's ADMIN role.
VITE_IAM_ACCESS_CODE=
# Cloudflare Turnstile site key (required in production). Dev builds default to the always-pass test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
